---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  route?: string;
  over?: boolean;
}

const { title, description, route, over = false } = Astro.props;
---

<Base title={title} description={description}>
  <div class="dsir-page">
    <SiteHeader route={route} over={over} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </div>
</Base>
