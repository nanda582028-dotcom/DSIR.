---
/* Red duotone plate. With src the photograph is duotoned; without one it renders
   the placeholder hatch, which is the state the whole site ships in until DSIR
   supplies photography. */
interface Props {
  src?: string;
  alt?: string;
  label?: string;
  tone?: 'red' | 'mono';
  ratio?: string;
  grain?: boolean;
  class?: string;
  fill?: boolean;
}

const {
  src,
  alt = '',
  label = 'IMAGE',
  tone = 'mono',
  ratio = '3 / 4',
  grain = true,
  class: className,
  fill = false,
} = Astro.props;

const wash = tone === 'mono' ? 'var(--white)' : 'var(--red)';
const washOpacity = src ? 0.42 : 0.5;
---

<figure
  class:list={['duotone', className]}
  style={`--duotone-ratio:${ratio};--duotone-wash:${wash};--duotone-wash-opacity:${washOpacity};${fill ? 'position:absolute;inset:0;aspect-ratio:auto;' : ''}`}
>
  {
    src ? (
      <img src={src} alt={alt} class="duotone__img" loading="lazy" decoding="async" />
    ) : (
      <div class="duotone__plate" aria-hidden="true">
        <span class="duotone__label">{label}</span>
      </div>
    )
  }
  <div class="duotone__wash" aria-hidden="true"></div>
  <div class="duotone__void" aria-hidden="true"></div>
  {grain && <div class="duotone__grain" aria-hidden="true" />}
</figure>

<style>
  .duotone {
    margin: 0;
    position: relative;
    aspect-ratio: var(--duotone-ratio);
    overflow: hidden;
    background: var(--ink-950);
  }

  .duotone__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.25);
    display: block;
  }

  .duotone__plate {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: repeating-linear-gradient(
      135deg,
      var(--ink-900) 0 10px,
      var(--ink-800) 10px 20px
    );
  }

  .duotone__label {
    font-family: var(--font-light);
    font-weight: var(--weight-light);
    font-size: var(--size-micro);
    letter-spacing: var(--track-lux);
    color: rgba(255, 255, 255, 0.5);
  }

  .duotone__wash {
    position: absolute;
    inset: 0;
    background: var(--duotone-wash);
    mix-blend-mode: multiply;
    opacity: var(--duotone-wash-opacity);
  }

  .duotone__void {
    position: absolute;
    inset: 0;
    background: var(--void);
    mix-blend-mode: multiply;
    opacity: 0.45;
  }

  .duotone__grain {
    position: absolute;
    inset: 0;
    background-image: var(--grain-url);
    opacity: var(--grain-opacity);
    mix-blend-mode: overlay;
    pointer-events: none;
  }
</style>
