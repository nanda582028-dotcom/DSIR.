---
import { getCollection } from 'astro:content';
import PageShell from '../../components/PageShell.astro';
import DuotoneImage from '../../components/DuotoneImage.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { SECTIONS, SITE, sectionLabel } from '../../data/site';

export async function getStaticPaths() {
  return SECTIONS.map((section) => ({
    params: { slug: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props;

const pieces = (await getCollection('articles'))
  .filter((a) => a.data.section === section.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/* The lead piece is given more room; the rest run in the grid. */
const [lead, ...others] = pieces;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: '2-digit' }).replace(/\//g, '.');
---

<PageShell
  title={`${section.label} — ${SITE.title}`}
  description={section.standfirst}
  route={section.slug}
>
  <div class="dsir-shell dsir-shell--narrow sec">
    <div class="sec__masthead">
      <div>
        <div class="caps caps--accent">Section</div>
        <h1 class="headline headline--mega sec__title">{section.label}</h1>
        <p class="standfirst sec__standfirst">{section.standfirst}</p>
      </div>
      <div class="sec__editor">
        <span class="caps caps--micro caps--faint">Section editor</span>
        {section.editor && <span class="sec__editorname">{section.editor}</span>}
        <span class="sec__editormeta">
          {pieces.length} {pieces.length === 1 ? 'piece' : 'pieces'} · since Issue {SITE.currentIssue}
        </span>
      </div>
    </div>

    <nav class="tabs" aria-label="Sections">
      {
        SECTIONS.map((s) => (
          <a
            class:list={['tabs__tab', s.slug === section.slug && 'is-active']}
            href={`/section/${s.slug}/`}
            aria-current={s.slug === section.slug ? 'page' : undefined}
          >
            {s.label}
          </a>
        ))
      }
    </nav>

    {
      pieces.length === 0 ? (
        <p class="sec__empty">Nothing filed in this section yet.</p>
      ) : (
        <>
          {lead && (
            <section class="sec__lead">
              <ArticleCard article={lead} ratio="16 / 9" level="title" />
            </section>
          )}

          {others.length > 0 && (
            <section class="sec__list">
              {others.map((p) => (
                <a class="card-link sec__row" href={`/article/${p.id}/`}>
                  <DuotoneImage
                    src={p.data.heroImage}
                    alt={p.data.heroAlt ?? ''}
                    label="PLATE"
                    tone="mono"
                    ratio="3 / 4"
                    class="sec__plate"
                  />
                  <div class="sec__rowbody">
                    <h3 class="headline headline--sub">{p.data.title}</h3>
                    <p class="sec__blurb">{p.data.standfirst}</p>
                    <div class="sec__byline">
                      <span class="sec__by">{p.data.author}</span>
                      <span class="caps caps--micro sec__date">
                        {sectionLabel(p.data.section)} · {fmt(p.data.date)}
                      </span>
                    </div>
                  </div>
                </a>
              ))}
            </section>
          )}
        </>
      )
    }
  </div>
</PageShell>

<style>
  .sec { padding-top: 64px; }

  .sec__masthead {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 44px;
    align-items: end;
    border-bottom: var(--line-strong);
    padding-bottom: 28px;
  }

  .sec__title { margin-top: 10px; }
  .sec__standfirst { margin-top: 16px; }

  .sec__editor {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sec__editorname { font: var(--type-body); }

  .sec__editormeta {
    font: var(--type-small);
    color: var(--text-muted);
  }

  .tabs {
    margin-top: 28px;
    display: flex;
    gap: var(--space-7);
    border-bottom: var(--line-hairline);
    flex-wrap: wrap;
  }

  .tabs__tab {
    border-bottom: 1px solid transparent;
    padding: 0 0 14px;
    margin-bottom: -1px;
    font-family: var(--font-light);
    font-weight: var(--weight-light);
    font-size: var(--size-label);
    letter-spacing: var(--track-lux);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .tabs__tab:hover { color: var(--text-accent); }

  .tabs__tab.is-active {
    color: var(--text-body);
    border-bottom-color: var(--text-body);
  }

  .sec__lead {
    margin-top: 44px;
    padding-bottom: 44px;
    border-bottom: var(--line-hairline);
  }

  .sec__list {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 44px;
  }

  .sec__row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 20px;
  }

  .sec__rowbody {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .sec__blurb {
    font: var(--type-small);
    color: var(--text-muted);
    margin: 0;
  }

  .sec__byline {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sec__by {
    font: var(--type-small);
    color: var(--text-muted);
    font-style: italic;
  }

  .sec__date { color: var(--text-accent); }

  .sec__empty {
    margin-top: 48px;
    font: var(--type-lead);
    color: var(--text-muted);
  }

  @media (max-width: 980px) {
    .sec__masthead { grid-template-columns: 1fr; gap: 24px; align-items: start; }
    .sec__list { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .sec { padding-top: 40px; }
    .sec__row { grid-template-columns: 110px 1fr; gap: 16px; }
    .tabs { gap: var(--space-5); }
  }
</style>
